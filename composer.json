{
    "name": "doppar/guard",
    "description": "A authorization package for doppar framework",
    "type": "library",
    "license": "MIT",
    "support": {
        "issues": "https://github.com/doppar/guard/issues",
        "source": "https://github.com/doppar/guard"
    },
    "authors": [
        {
            "name": "Mahedi Hasan",
            "email": "mahedy150101@gmail.com"
        }
    ],
    "require": {
        "php": "^8.5"
    },
    "require-dev": {
        "mockery/mockery": "^1.6",
        "phpunit/phpunit": "^13.3"
    },
    "autoload": {
        "psr-4": {
            "Doppar\\Authorizer\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Doppar\\Authorizer\\Tests\\": "tests/"
        }
    },
    "config": {
        "sort-packages": true
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}